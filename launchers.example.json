{
  "claude": {
    "label": "Claude Code",
    "rounds": 4,
    "models": [
      "fable",
      "opus",
      "sonnet",
      "haiku"
    ],
    "command": [
      "claude",
      "-p",
      "--model",
      "opus",
      "--allowedTools",
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep"
    ]
  },
  "codex": {
    "label": "Codex",
    "rounds": 4,
    "command": [
      "codex",
      "exec",
      "--skip-git-repo-check",
      "-s",
      "workspace-write",
      "-c",
      "approval_policy=\"never\"",
      "-"
    ]
  },
  "omp": {
    "label": "OhMyPi",
    "rounds": 4,
    "command": [
      "omp",
      "-p",
      "--no-session",
      "--auto-approve",
      "@{brief_file}"
    ]
  }
}
